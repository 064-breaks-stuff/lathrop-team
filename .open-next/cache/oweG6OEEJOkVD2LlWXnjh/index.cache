{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--oweG6OEEJOkVD2LlWXnjh--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"/hero/hero.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/2a25918c5d8a5b08.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-a187ebefcdbd1c61.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f10ca8562d68747b.js\" async=\"\"></script><script src=\"/_next/static/chunks/214-628d75f432f1dabd.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/239-d33310ddfa6356f4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-33cb4717f9edc3d1.js\" async=\"\"></script><script src=\"/_next/static/chunks/b536a0f1-e8f58607f68c85b7.js\" async=\"\"></script><script src=\"/_next/static/chunks/72c373f8-424021f097ba852c.js\" async=\"\"></script><script src=\"/_next/static/chunks/182-a2bdc89f2142e193.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-35f0a793ce929245.js\" async=\"\"></script><title>Lathrop Team | Fox Cities Real Estate</title><meta name=\"description\" content=\"A three-generation Fox Cities real estate team helping buyers and sellers move with confidence.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"></div><div class=\"site\"><header class=\"site-header\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo icon\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/lathrop-logo-icon.jpg\"/><span class=\"site-logo-text\">LATHROP TEAM</span></a><nav class=\"site-nav\" aria-label=\"Main Navigation\"><a class=\"nav-link\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></nav></header><main class=\"site-main\"><section class=\"home-hero\"><div class=\"hero-loader\"><div class=\"hero-loader-inner\"><div class=\"hero-loader-frame\"><div class=\"hero-loader-logo\"><img alt=\"Lathrop Team logo\" loading=\"lazy\" width=\"48\" height=\"48\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/1.jpg\"/><span class=\"hero-loader-text\">LATHROP TEAM</span></div><span class=\"hero-loader-sparkle\"></span></div><div class=\"hero-loader-mask\"></div></div></div><div class=\"home-hero-background\" aria-hidden=\"true\"><img class=\"home-hero-fallback-image\" src=\"/hero/hero.jpg\" alt=\"\"/><div class=\"home-hero-scene\"></div></div><div class=\"home-hero-overlay\" aria-hidden=\"true\"></div><div class=\"home-hero-content\"><p class=\"hero-eyebrow\">Lathrop Team<span class=\"hero-eyebrow-rule\"></span>Fox Cities, Wisconsin</p><h1 class=\"hero-title\"><span>Fox Cities</span><span>Real Estate,</span><em>Refined.</em></h1><p class=\"hero-description\">Three generations of local expertise, a RealTrends verified performance record, and 525+ five-star reviews guiding you home.</p><p class=\"hero-affiliation\">Proudly affiliated with Keller Williams Fox Cities.</p><div class=\"hero-actions\"><a class=\"btn btn--light\" href=\"/buy\">Find your next home</a><a class=\"btn btn--outline-light\" href=\"/home-valuation\">See what your home is worth</a></div></div><div class=\"home-hero-index\" aria-hidden=\"true\"><span>01</span><span class=\"home-hero-index-line\"></span><span>Fox Cities</span></div><div class=\"home-hero-scroll\" aria-hidden=\"true\"><span>Scroll to explore</span><span class=\"home-hero-scroll-line\"></span></div></section><section class=\"trust-strip\" aria-label=\"Lathrop Team statistics\"><div class=\"trust-strip-intro\"><span class=\"section-eyebrow\">A proven record</span><span class=\"trust-strip-intro-line\"></span></div><div class=\"trust-strip-stats\"><div class=\"trust-stat\"><span class=\"trust-stat-value\">0<!-- -->+</span><span class=\"trust-stat-label\">Years of experience</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">$<!-- -->0.00<!-- -->M</span><span class=\"trust-stat-label\">Volume in 2024</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">0</span><span class=\"trust-stat-label\">Transaction sides in 2024</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">0<!-- -->+</span><span class=\"trust-stat-label\">Five-star reviews</span></div></div></section><section class=\"home-intro\"><div class=\"home-intro-mark\" aria-hidden=\"true\"><span>03</span><span>Generations</span></div><div class=\"home-intro-content\"><div class=\"\"><p class=\"section-eyebrow\">A family helping families</p><h2 class=\"home-section-title\">Experience that feels personal.</h2></div><div class=\"\"><div class=\"home-intro-copy\"><p>The Lathrop Team combines the wisdom of decades in the market with the energy of a new generation of agents.</p><p>We’re a family-run team that has helped hundreds of families buy and sell in Appleton and the surrounding Fox Cities communities. Every transaction receives the structure, data, and personal attention it deserves.</p><a class=\"text-link\" href=\"/about\">Discover our story<span aria-hidden=\"true\">↗</span></a></div></div></div></section><section class=\"home-featured\"><div class=\"home-featured-heading\"><div class=\"\"><p class=\"section-eyebrow\">Featured home</p><h2 class=\"home-section-title\">Find a place<br/>worth coming home to.</h2></div><div class=\"\"><a class=\"text-link\" href=\"/buy\">Explore available homes<span aria-hidden=\"true\">↗</span></a></div></div><div class=\"home-featured-visual\"><div class=\"home-featured-image-frame\"><img src=\"/hero/hero.jpg\" alt=\"Fox Cities property\" class=\"home-featured-image\"/><div class=\"home-featured-image-label\"><span>01</span><span>Fox Cities property</span></div></div><div class=\"home-featured-placeholder\"><span>Featured home</span><p>Listing details will be connected here later.</p></div></div></section><section class=\"home-pathways\"><div class=\"home-pathway home-pathway--buy\"><div class=\"home-pathway-number\">01</div><div class=\"\"><p class=\"section-eyebrow\">For buyers</p><h2 class=\"home-pathway-title\">Find your<br/>next chapter.</h2><p class=\"home-pathway-copy\">From the first search to the final signature, we bring local knowledge, clear advice, and steady support to the buying process.</p><a class=\"btn btn--light\" href=\"/buy\">Start your home search</a></div></div><div class=\"home-pathway home-pathway--sell\"><div class=\"home-pathway-number\">02</div><div class=\"\"><p class=\"section-eyebrow\">For sellers</p><h2 class=\"home-pathway-title\">Move forward<br/>with confidence.</h2><p class=\"home-pathway-copy\">From valuation and preparation to marketing and negotiation, we create a clear plan for your sale and manage every detail with care.</p><a class=\"btn btn--outline-light\" href=\"/home-valuation\">Get your home valuation</a></div></div></section><section class=\"home-communities\"><div class=\"home-communities-header\"><div class=\"\"><p class=\"section-eyebrow\">Where we work</p><h2 class=\"home-section-title\">The Fox Cities,<br/>with local perspective.</h2></div><div class=\"\"><div class=\"home-communities-description\"><p>Each community has its own rhythm, character, and opportunities. We’ll help you understand the details before you make a decision.</p><a class=\"text-link\" href=\"/communities\">Explore communities<span aria-hidden=\"true\">↗</span></a></div></div></div><div class=\"\"><div class=\"home-community-rail\"><a class=\"home-community-card\" href=\"/communities#appleton\"><span class=\"home-community-index\">01</span><span class=\"home-community-name\">Appleton</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#neenah\"><span class=\"home-community-index\">02</span><span class=\"home-community-name\">Neenah</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#menasha\"><span class=\"home-community-index\">03</span><span class=\"home-community-name\">Menasha</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#kaukauna\"><span class=\"home-community-index\">04</span><span class=\"home-community-name\">Kaukauna</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#kimberly\"><span class=\"home-community-index\">05</span><span class=\"home-community-name\">Kimberly</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#little-chute\"><span class=\"home-community-index\">06</span><span class=\"home-community-name\">Little Chute</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#greenville\"><span class=\"home-community-index\">07</span><span class=\"home-community-name\">Greenville</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#oshkosh\"><span class=\"home-community-index\">08</span><span class=\"home-community-name\">Oshkosh</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"home-reviews\"><div class=\"home-reviews-aside\"><span class=\"section-eyebrow\">Client perspective</span><span class=\"home-reviews-aside-mark\" aria-hidden=\"true\">✦</span></div><div class=\"home-reviews-content\"><div class=\"\"><h2 class=\"home-reviews-title\">525+<span>five-star reviews</span></h2><p class=\"home-reviews-copy\">Buyers and sellers have shared their experiences on platforms including Zillow and Google. Their words speak to our communication, availability, and market knowledge.</p><a class=\"text-link\" href=\"/reviews\">Read what clients say<span aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"home-team\"><div class=\"home-team-image-wrap\"><img src=\"/hero/hero.jpg\" alt=\"The Fox Cities area served by the Lathrop Team\" class=\"home-team-image\"/><div class=\"home-team-image-caption\"><span>The Lathrop Team</span><span>Appleton, Wisconsin</span></div></div><div class=\"home-team-content\"><div class=\"\"><p class=\"section-eyebrow\">Meet the team</p><h2 class=\"home-section-title\">A family helping<br/>families.</h2><p class=\"home-team-copy\">Diane, Shane, and Oliver Lathrop represent three generations in real estate. That depth shows up in how we price, how we negotiate, and how we support you through the process.</p><a class=\"text-link\" href=\"/team\">Meet Diane, Shane, and Oliver<span aria-hidden=\"true\">↗</span></a></div></div></section><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-grid\"><div class=\"footer-brand\"><div class=\"site-logo\"><img alt=\"Lathrop Team logo icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/lathrop-logo-icon.jpg\"/><span class=\"site-logo-text\">LATHROP TEAM</span></div><p>Three-generation Fox Cities real estate team with a RealTrends verified record and 525+ five-star reviews.</p></div><div><strong>Contact</strong><p>Diane Lathrop · (920) 428-9227 · diane@lathropteam.com</p><p>Shane Lathrop · (920) 428-0066 · shane@lathropteam.com</p><p>Oliver Lathrop · (920) 858-4424 · oliver@lathropteam.com</p></div><div class=\"footer-kw\"><strong>Keller Williams Fox Cities</strong><p>517 N. Westhill Blvd, Appleton, WI</p><p>Each office is independently owned and operated.</p></div></div></footer></div><script src=\"/_next/static/chunks/webpack-a187ebefcdbd1c61.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[245,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"default\\\"]\\n3:I[7831,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"default\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[8924,[],\\\"\\\"]\\n6:I[1356,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"Image\\\"]\\n7:I[4780,[\\\"367\\\",\\\"static/chunks/b536a0f1-e8f58607f68c85b7.js\\\",\\\"510\\\",\\\"static/chunks/72c373f8-424021f097ba852c.js\\\",\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"182\\\",\\\"stati