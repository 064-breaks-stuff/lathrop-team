{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/home-valuation/layout,_N_T_/home-valuation/page,_N_T_/home-valuation"}},"html":"<!DOCTYPE html><!--oweG6OEEJOkVD2LlWXnjh--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/2a25918c5d8a5b08.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-a187ebefcdbd1c61.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f10ca8562d68747b.js\" async=\"\"></script><script src=\"/_next/static/chunks/214-628d75f432f1dabd.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/239-d33310ddfa6356f4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-33cb4717f9edc3d1.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/home-valuation/page-79e50f476869a995.js\" async=\"\"></script><title>Home Valuation | Lathrop Team</title><meta name=\"description\" content=\"Get a realistic valuation for your Fox Cities home from a three-generation team.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"></div><div class=\"site\"><header class=\"site-header\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo icon\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/lathrop-logo-icon.jpg\"/><span class=\"site-logo-text\">LATHROP TEAM</span></a><nav class=\"site-nav\" aria-label=\"Main Navigation\"><a class=\"nav-link\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link nav-link--active\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></nav></header><main class=\"site-main\"><section class=\"page page-valuation\"><div class=\"\"><header class=\"section-heading\"><p class=\"section-eyebrow\">Home valuation</p><h2 class=\"section-title\">What is your Fox Cities home really worth?</h2></header></div><div class=\"page-body\"><div class=\"\"><p>Online estimates are generic. Our valuations are built on 35+ years of local experience and independently verified production data.</p><h3>Why our valuation is different</h3><ul class=\"page-list\"><li>We consider neighborhood-level trends in Appleton and the surrounding communities.</li><li>We factor in updates, condition, and unique features—not just square footage.</li><li>We cross-check against recent sales we’ve personally handled, plus local MLS data.</li></ul><p>The result is a realistic pricing strategy, not just a number. Share a bit about your property and we’ll follow up with a personalized valuation.</p></div><div class=\"page-form-wrapper\"><form class=\"form form--valuation\"><div class=\"form-row\"><label class=\"form-label\">Property address<input class=\"form-input\" type=\"text\" required=\"\" placeholder=\"Street address\" name=\"address\"/></label></div><div class=\"form-row form-row--inline\"><label class=\"form-label\">City<input class=\"form-input\" type=\"text\" required=\"\" placeholder=\"Appleton\" name=\"city\"/></label><label class=\"form-label\">State<input class=\"form-input\" type=\"text\" required=\"\" placeholder=\"WI\" name=\"state\"/></label><label class=\"form-label\">ZIP<input class=\"form-input\" type=\"text\" required=\"\" placeholder=\"54914\" name=\"zip\"/></label></div><div class=\"form-row form-row--inline\"><label class=\"form-label\">Beds<input class=\"form-input\" type=\"number\" min=\"0\" placeholder=\"3\" name=\"beds\"/></label><label class=\"form-label\">Baths<input class=\"form-input\" type=\"number\" min=\"0\" placeholder=\"2\" name=\"baths\"/></label><label class=\"form-label\">Approx. square feet<input class=\"form-input\" type=\"number\" min=\"0\" placeholder=\"1800\" name=\"sqft\"/></label></div><div class=\"form-row\"><label class=\"form-label\">When are you thinking of selling?<select class=\"form-input\" name=\"timeframe\"><option value=\"\" disabled=\"\" selected=\"\">Choose an option</option><option value=\"0-3\">Within 0–3 months</option><option value=\"3-6\">Within 3–6 months</option><option value=\"6-12\">Within 6–12 months</option><option value=\"12+\">12+ months / just curious</option></select></label></div><div class=\"form-row\"><label class=\"form-label\">Name<input class=\"form-input\" type=\"text\" required=\"\" placeholder=\"Your name\" name=\"name\"/></label></div><div class=\"form-row form-row--inline\"><label class=\"form-label\">Email<input class=\"form-input\" type=\"email\" required=\"\" placeholder=\"you@example.com\" name=\"email\"/></label><label class=\"form-label\">Phone<input class=\"form-input\" type=\"tel\" placeholder=\"(920) 555-1234\" name=\"phone\"/></label></div><div class=\"form-row form-actions\"><button class=\"btn btn--primary\">Get my valuation</button></div></form></div></div></section><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-grid\"><div class=\"footer-brand\"><div class=\"site-logo\"><img alt=\"Lathrop Team logo icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/lathrop-logo-icon.jpg\"/><span class=\"site-logo-text\">LATHROP TEAM</span></div><p>Three-generation Fox Cities real estate team with a RealTrends verified record and 525+ five-star reviews.</p></div><div><strong>Contact</strong><p>Diane Lathrop · (920) 428-9227 · diane@lathropteam.com</p><p>Shane Lathrop · (920) 428-0066 · shane@lathropteam.com</p><p>Oliver Lathrop · (920) 858-4424 · oliver@lathropteam.com</p></div><div class=\"footer-kw\"><strong>Keller Williams Fox Cities</strong><p>517 N. Westhill Blvd, Appleton, WI</p><p>Each office is independently owned and operated.</p></div></div></footer></div><script src=\"/_next/static/chunks/webpack-a187ebefcdbd1c61.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[245,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"default\\\"]\\n3:I[7831,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"default\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[8924,[],\\\"\\\"]\\n6:I[1356,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"239\\\",\\\"static/chunks/239-d33310ddfa6356f4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-33cb4717f9edc3d1.js\\\"],\\\"Image\\\"]\\n7:I[5413,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"186\\\",\\\"static/chunks/app/home-valuation/page-79e50f476869a995.js\\\"],\\\"default\\\"]\\nb:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/2a25918c5d8a5b08.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"oweG6OEEJOkVD2LlWXnjh\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"hom