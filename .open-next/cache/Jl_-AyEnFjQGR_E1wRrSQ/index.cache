[\"$\",\"span\",null,{\"className\":\"home-community-arrow\",\"aria-hidden\":\"true\",\"children\":\"↗\"}]]}],[\"$\",\"$L5\",\"oshkosh\",{\"href\":\"/communities#oshkosh\",\"className\":\"home-community-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-community-index\",\"children\":\"08\"}],[\"$\",\"span\",null,{\"className\":\"home-community-name\",\"children\":\"Oshkosh\"}],[\"$\",\"span\",null,{\"className\":\"home-community-arrow\",\"aria-hidden\":\"true\",\"children\":\"↗\"}]]}]]}]}]]}]\nc:[\"$\",\"section\",null,{\"id\":\"reviews\",\"className\":\"home-client-reviews\",\"aria-labelledby\":\"home-client-reviews-title\",\"children\":[[\"$\",\"div\",null,{\"className\":\"home-client-reviews-heading\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"home-client-reviews-eyebrow\",\"children\":\"Client perspective\"}],[\"$\",\"h2\",null,{\"id\":\"home-client-reviews-title\",\"children\":[\"Trust is built\",[\"$\",\"em\",null,{\"children\":\"one move at a time.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"home-client-reviews-intro\",\"children\":[[\"$\",\"p\",null,{\"className\":\"home-client-reviews-count\",\"children\":[\"525+\",[\"$\",\"span\",null,{\"children\":\"five-star reviews\"}]]}],[\"$\",\"p\",null,{\"className\":\"home-client-reviews-summary\",\"children\":\"Results matter, but so does the experience of getting there. Our goal is for you to feel informed, supported, and confident in the decisions ahead.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"home-client-reviews-grid\",\"children\":[[\"$\",\"figure\",\"corey-miller\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"Shane is a great realtor! I had a wonderful experience with him and would suggest him to anyone looking for a knowledgeable realtor. He took the time to explain the home buying process and would point out and teach about aspects of home building and home buying. He was always available for showings and to answer any questions. He made my first home buying experience and very positive one!\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Corey Miller\"}]]}],[\"$\",\"figure\",\"kayla-fischer\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"I’ll never stop suggesting the Lathrop team. Shane and Diane were amazing to work with, especially during the trying time of buying a house in this market. Shane was so patient and never made us feel bad for some of our hesitations. This team is honest and not pushy, which is very very appreciated. Shane and the Lathrop team will be the only realtors we use for the rest of our home buying/selling time and the only ones we recommend. 10/10\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Kayla Fischer\"}]]}],[\"$\",\"figure\",\"julie\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"I had an outstanding experience working with Oliver. After my previous realtor struggled for nearly a year to find tenants for my commercial rental properties, Oliver stepped in and had both units rented in a very short time. His communication, professionalism, and knowledge of the local market made the entire process smooth and stress-free. I highly recommend Oliver and his team to anyone looking for a realtor who truly gets results.\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Julie\"}]]}],[\"$\",\"figure\",\"ben-kromanaker\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"The entire Lathrop Team, especially Oliver, was extremely helpful in helping me and my fiance find our first home. They were honest and helped us look for red flags in homes and helped us learn what to look for in a house. As first time home buyers it was great to have some honest guidance, and no pressure on the sales side of things. They were always there, even on short notice to help us. And we found the perfect home to grow in.\"}]}],\"$L14\"]}],\"$L15\",\"$L16\"]}],\"$L17\"]}]\nd:[\"$\",\"section\",null,{\"className\":\"home-team\",\"children\":[[\"$\",\"div\",null,{\"className\":\"home-team-image-wrap\",\"children\":[[\"$\",\"img\",null,{\"src\":\"/hero/hero2.jpg\",\"alt\":\"The Fox Cities area served by the Lathrop Team\",\"className\":\"home-team-image\"}],[\"$\",\"div\",null,{\"className\":\"home-team-image-caption\",\"children\":[[\"$\",\"span\",null,{\"children\":\"The Lathrop Team\"}],[\"$\",\"span\",null,{\"children\":\"Appleton, Wisconsin\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"home-team-content\",\"children\":[\"$\",\"$L7\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"section-eyebrow\",\"children\":\"Meet the team\"}],[\"$\",\"h2\",null,{\"className\":\"home-section-title\",\"children\":[\"A family helping\",[\"$\",\"br\",null,{}],\"families.\"]}],[\"$\",\"p\",null,{\"className\":\"home-team-copy\",\"children\":\"Diane, Shane, and Oliver Lathrop represent three generations in real estate. That depth shows up in how we price, how we negotiate, and how we support you through the process.\"}],[\"$\",\"$L5\",null,{\"href\":\"/team\",\"className\":\"text-link\",\"children\":[\"Meet Diane, Shane, and Oliver\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"↗\"}]]}]]}]}]]}]\ne:[\"$\",\"$L18\",null,{}]\nf:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/71bc776355d7c6fa.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n10:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/e64e10117b556986.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n11:[\"$\",\"$L19\",null,{\"children\":[\"$L1a\",[\"$\",\"$L1b\",null,{\"promise\":\"$@1c\"}]]}]\n12:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L1d\",null,{\"children\":\"$L1e\"}],null],[\"$\",\"$L1f\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$20\",null,{\"fallback\":null,\"children\":\"$L21\"}]}]}]]}]\n14:[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Ben Kromanaker\"}]\n15:[\"$\",\"figure\",\"patty-managan\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"Thank you Lathrop team for helping us sell our home and finding our forever home! Your professional guidance and suggestions helped so much with this process. Your work behind the scenes making sure all was going as planned went above and beyond and did not go unnoticed!\\nWe certainly chose the right team and couldn’t have done any of this without your help. Always immediate responses to our questions and concerns whether it was a phone call, text or email.\\nSharing in our excitement was special!\\nThank you Diane, Shane, and Oliver!\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Patty Managan\"}]]}]\n16:[\"$\",\"figure\",\"larry-martin\",{\"className\":\"home-client-review-card\",\"children\":[[\"$\",\"span\",null,{\"className\":\"home-client-review-mark\",\"aria-hidden\":\"true\",\"children\":\"“\"}],[\"$\",\"blockquote\",null,{\"className\":\"home-client-review-quote\",\"children\":[\"$\",\"p\",null,{\"children\":\"A real team that’s Easy to work with. Honest and accommodating. Having A wealth of knowledge in services and community, makes the Lathrop’s an easy choice. Thank You for everything!\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"home-client-review-author\",\"children\":\"Larry Martin\"}]]}]\n17:[\"$\",\"div\",null,{\"className\":\"home-client-reviews-actions\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Whether you are buying, selling, or thinking ahead, we are here to answer questions and help you create a clear plan.\"}],[\"$\",\"$L5\",null,{\"href\":\"/contact\",\"className\":\"btn\",\"children\":\"Start a conversation\"}]]}]\n1e:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1a:null\n1c:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Lathrop Team | Fox Cities Real Estate\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A three-generation Fox Cities real estate team helping buyers and sellers move with confidence.\"}]],\"error\":null,\"digest\":\"$undefined\"}\n21:\"$1c:metadata\"\n"}