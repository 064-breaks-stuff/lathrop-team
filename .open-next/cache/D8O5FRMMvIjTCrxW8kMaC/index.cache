/script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"boot-screen\" aria-hidden=\"true\"><div class=\"boot-screen-frame\"></div><div class=\"boot-screen-content\"><p class=\"boot-screen-message\">You&#x27;re at the perfect place for<span>Fox Cities real estate talk!</span></p></div><span class=\"boot-screen-index\">Fox Cities, Wisconsin</span></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"><div class=\"page-transition-frame\"></div><span class=\"page-transition-mark\">L</span></div><div class=\"site site--loading\" aria-hidden=\"true\"><header class=\"site-header\"><div class=\"site-header-inner\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><nav class=\"site-nav-wrap\" aria-label=\"Main navigation\"><div class=\"site-nav-desktop\"><a class=\"nav-link\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></div><button class=\"site-nav-toggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"_R_4pb_\"><span class=\"site-nav-toggle-label\">Menu</span><span class=\"site-nav-toggle-icon\" aria-hidden=\"true\"><span></span><span></span></span></button><div id=\"_R_4pb_\" class=\"site-nav-mobile\"><div class=\"site-nav-mobile-inner\"><div class=\"site-nav-mobile-links\"><a class=\"site-nav-mobile-link\" href=\"/buy\"><span>Buy</span><span>01</span></a><a class=\"site-nav-mobile-link\" href=\"/sell\"><span>Sell</span><span>02</span></a><a class=\"site-nav-mobile-link\" href=\"/home-valuation\"><span>Home Valuation</span><span>03</span></a><a class=\"site-nav-mobile-link\" href=\"/communities\"><span>Communities</span><span>04</span></a><a class=\"site-nav-mobile-link\" href=\"/reviews\"><span>Reviews</span><span>05</span></a><a class=\"site-nav-mobile-link\" href=\"/team\"><span>Team</span><span>06</span></a><a class=\"site-nav-mobile-link\" href=\"/about\"><span>About</span><span>07</span></a><a class=\"site-nav-mobile-link\" href=\"/contact\"><span>Contact</span><span>08</span></a></div><a class=\"site-nav-mobile-cta\" href=\"/home-valuation\">Get your home value <span aria-hidden=\"true\">↗</span></a></div></div></nav></div></header><main class=\"site-main\"><section class=\"home-hero\"><div class=\"home-hero-background\" aria-hidden=\"true\"><img class=\"home-hero-fallback-image\" src=\"/hero/hero.jpg\" alt=\"\"/><div class=\"home-hero-scene\"></div></div><div class=\"home-hero-overlay\" aria-hidden=\"true\"></div><div class=\"home-hero-content\"><p class=\"hero-eyebrow\">Lathrop Team<span class=\"hero-eyebrow-rule\"></span>Fox Cities, Wisconsin</p><h1 class=\"hero-title\"><span>Fox Cities</span><span>Real Estate,</span><em>Refined.</em></h1><p class=\"hero-description\">Three generations of local expertise, a RealTrends verified performance record, and 525+ five-star reviews guiding you home.</p><p class=\"hero-affiliation\">Proudly affiliated with Keller Williams Fox Cities.</p><div class=\"hero-actions\"><a class=\"btn btn--light\" href=\"/buy\">Find your next home</a><a class=\"btn btn--outline-light\" href=\"/home-valuation\">See what your home is worth</a></div></div><div class=\"home-hero-index\" aria-hidden=\"true\"><span>01</span><span class=\"home-hero-index-line\"></span><span>Fox Cities</span></div><div class=\"home-hero-scroll\" aria-hidden=\"true\"><span>Scroll to explore</span><span class=\"home-hero-scroll-line\"></span></div></section><section class=\"trust-strip\" aria-label=\"Lathrop Team statistics\"><div class=\"trust-strip-intro\"><span class=\"section-eyebrow\">A proven record</span><span class=\"trust-strip-intro-line\"></span></div><div class=\"trust-strip-stats\"><div class=\"trust-stat\"><span class=\"trust-stat-value\">0<!-- -->+</span><span class=\"trust-stat-label\">Years of experience</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">$<!-- -->0.00<!-- -->M</span><span class=\"trust-stat-label\">Volume in 2024</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">0</span><span class=\"trust-stat-label\">Transaction sides in 2024</span></div><div class=\"trust-stat\"><span class=\"trust-stat-value\">0<!-- -->+</span><span class=\"trust-stat-label\">Five-star reviews</span></div></div></section><section class=\"home-intro\"><div class=\"home-intro-mark\" aria-hidden=\"true\"><span>03</span><span>Generations</span></div><div class=\"home-intro-content\"><div class=\"\"><p class=\"section-eyebrow\">A family helping families</p><h2 class=\"home-section-title\">Experience that feels personal.</h2></div><div class=\"\"><div class=\"home-intro-copy\"><p>The Lathrop Team combines the wisdom of decades in the market with the energy of a new generation of agents.</p><p>We’re a family-run team that has helped hundreds of families buy and sell in Appleton and the surrounding Fox Cities communities. Every transaction receives the structure, data, and personal attention it deserves.</p><a class=\"text-link\" href=\"/about\">Discover our story<span aria-hidden=\"true\">↗</span></a></div></div></div></section><section class=\"home-featured\"><div class=\"home-featured-heading\"><div class=\"\"><p class=\"section-eyebrow\">Featured home</p><h2 class=\"home-section-title\">Find a place<br/>worth coming home to.</h2></div><div class=\"\"><a class=\"text-link\" href=\"/buy\">Explore available homes<span aria-hidden=\"true\">↗</span></a></div></div><div class=\"home-featured-visual\"><div class=\"home-featured-image-frame\"><img src=\"/hero/hero.jpg\" alt=\"Fox Cities property\" class=\"home-featured-image\"/><div class=\"home-featured-image-label\"><span>01</span><span>Fox Cities property</span></div></div><div class=\"home-featured-placeholder\"><span>Featured home</span><p>Listing details will be connected here later.</p></div></div></section><section class=\"home-pathways\"><div class=\"home-pathway home-pathway--buy\"><div class=\"home-pathway-number\">01</div><div class=\"\"><p class=\"section-eyebrow\">For buyers</p><h2 class=\"home-pathway-title\">Find your<br/>next chapter.</h2><p class=\"home-pathway-copy\">From the first search to the final signature, we bring local knowledge, clear advice, and steady support to the buying process.</p><a class=\"btn btn--light\" href=\"/buy\">Start your home search</a></div></div><div class=\"home-pathway home-pathway--sell\"><div class=\"home-pathway-number\">02</div><div class=\"\"><p class=\"section-eyebrow\">For sellers</p><h2 class=\"home-pathway-title\">Move forward<br/>with confidence.</h2><p class=\"home-pathway-copy\">From valuation and preparation to marketing and negotiation, we create a clear plan for your sale and manage every detail with care.</p><a class=\"btn btn--outline-light\" href=\"/home-valuation\">Get your home valuation</a></div></div></section><section class=\"home-communities\"><div class=\"home-communities-header\"><div class=\"\"><p class=\"section-eyebrow\">Where we work</p><h2 class=\"home-section-title\">The Fox Cities,<br/>with local perspective.</h2></div><div class=\"\"><div class=\"home-communities-description\"><p>Each community has its own rhythm, character, and opportunities. We’ll help you understand the details before you make a decision.</p><a class=\"text-link\" href=\"/communities\">Explore communities<span aria-hidden=\"true\">↗</span></a></div></div></div><div class=\"\"><div class=\"home-community-rail\"><a class=\"home-community-card\" href=\"/communities#appleton\"><span class=\"home-community-index\">01</span><span class=\"home-community-name\">Appleton</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#neenah\"><span class=\"home-community-index\">02</span><span class=\"home-community-name\">Neenah</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#menasha\"><span class=\"home-community-index\">03</span><span class=\"home-community-name\">Menasha</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#kaukauna\"><span class=\"home-community-index\">04</span><span class=\"home-community-name\">Kaukauna</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#kimberly\"><span class=\"home-community-index\">05</span><span class=\"home-community-name\">Kimberly</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#little-chute\"><span class=\"home-community-index\">06</span><span class=\"home-community-name\">Little Chute</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#greenville\"><span class=\"home-community-index\">07</span><span class=\"home-community-name\">Greenville</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a><a class=\"home-community-card\" href=\"/communities#oshkosh\"><span class=\"home-community-index\">08</span><span class=\"home-community-name\">Oshkosh</span><span class=\"home-community-arrow\" aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"home-reviews\"><div class=\"home-reviews-aside\"><span class=\"section-eyebrow\">Client perspective</span><span class=\"home-reviews-aside-mark\" aria-hidden=\"true\">✦</span></div><div class=\"home-reviews-content\"><div class=\"\"><h2 class=\"home-reviews-title\">525+<span>five-star reviews</span></h2><p class=\"home-reviews-copy\">Buyers and sellers have shared their experiences on platforms including Zillow and Google. Their words speak to our communication, availability, and market knowledge.</p><a class=\"text-link\" href=\"/reviews\">Read what clients say<span aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"home-team\"><div class=\"home-team-image-wrap\"><img src=\"/hero/hero2.jpg\" alt=\"The Fox Cities area served by the Lathrop Team\" class=\"home-team-image\"/><div class=\"home-team-image-caption\"><span>The Lathrop Team</span><span>Appleton, Wisconsin</span></div></div><div class=\"home-team-content\"><div class=\"\"><p class=\"section-eyebrow\">Meet the team</p><h2 class=\"home-section-title\">A family helping<br/>families.</h2><p class=\"home-team-copy\">Diane, Shane, and Oliver Lathrop represent three generations in real estate. That depth shows up in how we price, how we negotiate, and how we support you through the process.</p><a class=\"text-link\" href=\"/team\">Meet Diane, Shane, and Oliver<span aria-hidden=\"true\">↗</span></a></div></div></section><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-top\"><div class=\"footer-brand\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><p>A three-generation Fox Cities real estate team bringing local perspective, documented performance, and personal guidance to every move.</p><a class=\"footer-text-link\" href=\"/contact\">Start a conversation <span aria-hidden=\"true\">↗</span></a></div><div class=\"footer-navigation\"><p class=\"footer-heading\">Explore</p><div class=\"footer-nav-links\"><a href=\"/buy\">Buy</a><a href=\"/sell\">Sell</a><a href=\"/home-valuation\">Home Valuation</a><a href=\"/communities\">Communities</a><a href=\"/team\">Team</a><a href=\"/about\">About</a><a href=\"/reviews\">Reviews</a><a href=\"/contact\">Contact</a></div></div><div class=\"footer-contact\"><p class=\"footer-heading\">Direct contact</p><address><p><strong>Diane Lathrop</strong><a href=\"mailto:diane@lathropteam.com\">diane@lathropteam.com</a><a href=\"tel:+19204289227\">(920) 428-9227</a></p><p><strong>Shane Lathrop</strong><a href=\"mailto:shane@lathropteam.com\">shane@lathropteam.com</a><a href=\"tel:+19204280066\">(920) 428-0066</a></p><p><strong>Oliver Lathrop</strong><a href=\"mailto:oliver@lathropteam.com\">oliver@lathropteam.com</a><a href=\"tel:+19208584424\">(920) 858-4424</a></p></address></div><div class=\"footer-map\"><div class=\"footer-map-header\"><p class=\"footer-heading\">Office location</p><span>Appleton, Wisconsin</span></div><div class=\"footer-map-frame\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2857.210069477556!2d-88.46770222396349!3d44.26449767107976!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8803b7a5ba3b6f2d%3A0x6b0d2f80904d9e2f!2sKeller%20Williams%20Fox%20Cities!5e0!3m2!1sen!2sin!4v1788252496599!5m2!1sen!2sin\" title=\"Keller Williams Fox Cities office location in Appleton, Wisconsin\" width=\"600\" height=\"450\" style=\"border:0\" allowFullScreen=\"\" loading=\"lazy\" referrerPolicy=\"strict-origin-when-cross-origin\"></iframe></div></div></div><div class=\"site-footer-compliance\"><div class=\"footer-kw\"><div class=\"footer-kw-heading\"><p>Keller Williams Fox Cities</p><img alt=\"Keller Williams Fox Cities\" loading=\"lazy\" width=\"132\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"footer-kw-logo\" style=\"color:transparent\" src=\"/PLACEHOLDER-KW-LOGO.jpg\"/></div><address>517 N. Westhill Blvd, Appleton, WI<br/>Each office is independently owned and operated.</address></div><div class=\"footer-compliance-marks\"><di