{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/buy/layout,_N_T_/buy/page,_N_T_/buy"}},"html":"<!DOCTYPE html><!--D8O5FRMMvIjTCrxW8kMaC--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"logos/1.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7d6937842080f396.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/0610f662fb4f8aec.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-c382ed19c2311dcb.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f10ca8562d68747b.js\" async=\"\"></script><script src=\"/_next/static/chunks/214-628d75f432f1dabd.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/356-ba125e9f1b9f7c55.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2bdc083cbf7c6af6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/buy/page-6464f54b6d747dc0.js\" async=\"\"></script><title>Buy in the Fox Cities | Lathrop Team | Lathrop Team</title><meta name=\"description\" content=\"Buy in the Fox Cities with a three-generation real estate team offering local guidance, data-backed advice, and steady support from search to closing.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"boot-screen\" aria-hidden=\"true\"><div class=\"boot-screen-frame\"></div><div class=\"boot-screen-content\"><p class=\"boot-screen-message\">You&#x27;re at the perfect place for<span>Fox Cities real estate talk!</span></p></div><span class=\"boot-screen-index\">Fox Cities, Wisconsin</span></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"><div class=\"page-transition-frame\"></div><span class=\"page-transition-mark\">L</span></div><div class=\"site site--loading\" aria-hidden=\"true\"><header class=\"site-header\"><div class=\"site-header-inner\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><nav class=\"site-nav-wrap\" aria-label=\"Main navigation\"><div class=\"site-nav-desktop\"><a class=\"nav-link nav-link--active\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></div><button class=\"site-nav-toggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"_R_4pb_\"><span class=\"site-nav-toggle-label\">Menu</span><span class=\"site-nav-toggle-icon\" aria-hidden=\"true\"><span></span><span></span></span></button><div id=\"_R_4pb_\" class=\"site-nav-mobile\"><div class=\"site-nav-mobile-inner\"><div class=\"site-nav-mobile-links\"><a class=\"site-nav-mobile-link site-nav-mobile-link--active\" href=\"/buy\"><span>Buy</span><span>01</span></a><a class=\"site-nav-mobile-link\" href=\"/sell\"><span>Sell</span><span>02</span></a><a class=\"site-nav-mobile-link\" href=\"/home-valuation\"><span>Home Valuation</span><span>03</span></a><a class=\"site-nav-mobile-link\" href=\"/communities\"><span>Communities</span><span>04</span></a><a class=\"site-nav-mobile-link\" href=\"/reviews\"><span>Reviews</span><span>05</span></a><a class=\"site-nav-mobile-link\" href=\"/team\"><span>Team</span><span>06</span></a><a class=\"site-nav-mobile-link\" href=\"/about\"><span>About</span><span>07</span></a><a class=\"site-nav-mobile-link\" href=\"/contact\"><span>Contact</span><span>08</span></a></div><a class=\"site-nav-mobile-cta\" href=\"/home-valuation\">Get your home value <span aria-hidden=\"true\">↗</span></a></div></div></nav></div></header><main class=\"site-main\"><main class=\"editorial-page page-buy\"><section class=\"editorial-hero\"><div class=\"editorial-hero-index\" aria-hidden=\"true\">01</div><div class=\"editorial-hero-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Buy with Lathrop Team</p></div><div class=\"\"><h1 class=\"editorial-hero-title\">Find the place<em>that feels like home.</em></h1></div><div class=\"\"><p class=\"editorial-hero-description\">Buying in the Fox Cities should feel informed, personal, and well-paced. We bring decades of local perspective to every search, offer, and next step.</p></div><div class=\"\"><div class=\"editorial-hero-actions\"><a class=\"btn btn--light\" href=\"/contact\">Start a conversation</a><a href=\"#buyer-guide\" class=\"btn btn--outline-light\">Explore the process</a></div></div></div><div class=\"editorial-hero-mark\" aria-hidden=\"true\">B</div><div class=\"editorial-hero-footnote\"><span>Fox Cities, Wisconsin</span><span class=\"editorial-hero-footnote-line\"></span><span>Buyer representation</span></div></section><section class=\"editorial-intro\"><div class=\"editorial-intro-aside\"><span class=\"editorial-section-number\">01 — The search</span><span class=\"editorial-intro-mark\" aria-hidden=\"true\">L</span></div><div class=\"editorial-intro-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>A team, not just an agent</p><h2 class=\"editorial-section-title\">Local knowledge makes<em>the difference.</em></h2></div><div class=\"editorial-intro-copy\"><p>We have lived and worked in the Fox Cities for decades. We know the streets, schools, commutes, and small details that do not appear in a search filter.</p><p>Whether you are moving across town, relocating to the area, or preparing for your first purchase, we help you understand your options before you feel pressure to decide.</p></div></div></section><section class=\"buyer-pillars\" aria-label=\"How we support buyers\"><div class=\"buyer-pillars-heading\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>How we guide buyers</p><h2 class=\"editorial-section-title\">A steadier way<em>to move forward.</em></h2></div></div><div class=\"buyer-pillars-list\"><div class=\"\"><article class=\"buyer-pillar\"><span class=\"buyer-pillar-number\">01</span><div class=\"buyer-pillar-content\"><h3>Local perspective</h3><p>We&#x27;ve lived everyday lives in the Fox Cities across 3 generations. That means we help you weigh the character of each neighborhood, everyday routines, resale considerations, and the details that make one street feel different from the next.</p></div></article></div><div class=\"\"><article class=\"buyer-pillar\"><span class=\"buyer-pillar-number\">02</span><div class=\"buyer-pillar-content\"><h3>Clearer decisions</h3><p>A strong offer is not simply the highest number. We use current market context, recent sales, property condition, and your priorities to help you move forward with clarity.</p></div></article></div><div class=\"\"><article class=\"buyer-pillar\"><span class=\"buyer-pillar-number\">03</span><div class=\"buyer-pillar-content\"><h3>Support that stays close</h3><p>From early lender conversations through inspections, negotiations, and closing, we coordinate the moving parts and keep you informed at every stage.</p></div></article></div></div></section><section class=\"buyer-guide\" id=\"buyer-guide\"><div class=\"buyer-guide-visual\" aria-hidden=\"true\"><div class=\"buyer-guide-frame\"><span class=\"buyer-guide-frame-index\">Guide / 01</span><span class=\"buyer-guide-frame-title\">Fox Cities</span><span class=\"buyer-guide-frame-subtitle\">Buyer’s Guide</span></div></div><div class=\"buyer-guide-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Coming soon</p><h2 class=\"editorial-section-title\">The Fox Cities<em>Buyer’s Guide.</em></h2><p class=\"buyer-guide-copy\">We are preparing a practical guide to buying in the Fox Cities: neighborhood context, the buying timeline, and what to expect at each important step. Join the list, and we will send it when it is ready.</p></div><div class=\"\"><a class=\"text-link\" href=\"/contact\">Reserve your copy <span aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"editorial-closing-cta\"><div class=\"\"><p class=\"editorial-eyebrow editorial-eyebrow--light\"><span class=\"editorial-eyebrow-rule\"></span>Your next move</p><h2>Ready to start<em>seeing homes?</em></h2><p>Tell us what you are looking for. We will help you create a clear, thoughtful plan for the search ahead.</p><a class=\"btn btn--light\" href=\"/contact\">Schedule a consultation</a></div></section></main><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-top\"><div class=\"footer-brand\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><p>A three-generation Fox Cities real estate team bringing local perspective, documented performance, and personal guidance to every move.</p><a class=\"footer-text-link\" href=\"/contact\">Start a conversation <span aria-hidden=\"true\">↗</span></a></div><div class=\"footer-navigation\"><p class=\"footer-heading\">Explore</p><div class=\"footer-nav-links\"><a href=\"/buy\">Buy</a><a href=\"/sell\">Sell</a><a href=\"/home-valuation\">Home Valuation</a><a href=\"/communities\">Communities</a><a href=\"/team\">Team</a><a href=\"/about\">About</a><a href=\"/reviews\">Reviews</a><a href=\"/contact\">Contact</a></div></div><div class=\"footer-contact\"><p class=\"footer-heading\">Direct contact</p><address><p><strong>Diane Lathrop</strong><a href=\"mailto:diane@lathropteam.com\">diane@lathropteam.com</a><a href=\"tel:+19204289227\">(920) 428-9227</a></p><p><strong>Shane Lathrop</strong><a href=\"mailto:shane@lathropteam.com\">shane@lathropteam.com</a><a href=\"tel:+19204280066\">(920) 428-0066</a></p><p><strong>Oliver Lathrop</strong><a href=\"mailto:oliver@lathropteam.com\">oliver@lathropteam.com</a><a href=\"tel:+19208584424\">(920) 858-4424</a></p></address></div><div class=\"footer-map\"><div class=\"footer-map-header\"><p class=\"footer-heading\">Office location</p><span>Appleton, Wisconsin</span></div><div class=\"footer-map-frame\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2857.210069477556!2d-88.46770222396349!3d44.26449767107976!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8803b7a5ba3b6f2d%3A0x6b0d2f80904d9e2f!2sKeller%20Williams%20Fox%20Cities!5e0!3m2!1sen!2sin!4v1788252496599!5m2!1sen!2sin\" title=\"Keller Williams Fox Cities office location in Appleton, Wisconsin\" width=\"600\" height=\"450\" style=\"border:0\" allowFullScreen=\"\" loading=\"lazy\" referrerPolicy=\"strict-origin-when-cross-origin\"></iframe></div></div></div><div class=\"site-footer-compliance\"><div class=\"footer-kw\"><div class=\"footer-kw-heading\"><p>Keller Williams Fox Cities</p><img alt=\"Keller Williams Fox Cities\" loading=\"lazy\" width=\"132\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"footer-kw-logo\" style=\"color:transparent\" src=\"/PLACEHOLDER-KW-LOGO.jpg\"/></div><address>517 N. Westhill Blvd, Appleton, WI<br/>Each office is independently owned and operated.</address></div><div class=\"footer-compliance-marks\"><div class=\"footer-compliance-mark\"><img alt=\"Equal Housing Opportunity\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/PLACEHOLDER-EQUAL-HOUSING.jpg\"/><span>Equal Housing Opportunity</span></div><div class=\"footer-compliance-mark\"><img alt=\"REALTOR®\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/PLACEHOLDER-REALTOR-MARK.jpg\"/><span>REALTOR®</span></div></div></div><div class=\"site-footer-bottom\"><p>© <!-- -->2026<!-- --> Lathrop Team. All rights reserved.</p><div><span>Fox Cities, Wisconsin</span><span>RealTrends Verified · 525+ five-star reviews</span></div></div></footer></div><script src=\"/_next/static/chunks/webpack-c382ed19c2311dcb.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[5948,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-ba125e9f1b9f7c55.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-2bdc083cbf7c6af6.js\\\"],\\\"default\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[5413,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"329\\\",\\\"static/chunks/app/buy/page-6464f54b6d747dc0.js\\\"],\\\"default\\\"]\\n6:I[2619,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"329\\\",\\\"static/chunks/app/buy/page-6464f54b6d747dc0.js\\\"],\\\"\\\"]\\nd:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/7d6937842080f396.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/0610f662fb4f8aec.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"D8O5FRMMvIjTCr