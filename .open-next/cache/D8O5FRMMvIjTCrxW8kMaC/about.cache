{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"}},"html":"<!DOCTYPE html><!--D8O5FRMMvIjTCrxW8kMaC--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"logos/1.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7d6937842080f396.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/0610f662fb4f8aec.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-c382ed19c2311dcb.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f10ca8562d68747b.js\" async=\"\"></script><script src=\"/_next/static/chunks/214-628d75f432f1dabd.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/356-ba125e9f1b9f7c55.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2bdc083cbf7c6af6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/about/page-44b8c3991ffaadf0.js\" async=\"\"></script><title>About Lathrop Team | Fox Cities Real Estate | Lathrop Team</title><meta name=\"description\" content=\"Learn the story behind the Lathrop Team: three generations of Fox Cities real estate experience, locally grounded guidance, and independently verified results.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"boot-screen\" aria-hidden=\"true\"><div class=\"boot-screen-frame\"></div><div class=\"boot-screen-content\"><p class=\"boot-screen-message\">You&#x27;re at the perfect place for<span>Fox Cities real estate talk!</span></p></div><span class=\"boot-screen-index\">Fox Cities, Wisconsin</span></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"><div class=\"page-transition-frame\"></div><span class=\"page-transition-mark\">L</span></div><div class=\"site site--loading\" aria-hidden=\"true\"><header class=\"site-header\"><div class=\"site-header-inner\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><nav class=\"site-nav-wrap\" aria-label=\"Main navigation\"><div class=\"site-nav-desktop\"><a class=\"nav-link\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link nav-link--active\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></div><button class=\"site-nav-toggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"_R_4pb_\"><span class=\"site-nav-toggle-label\">Menu</span><span class=\"site-nav-toggle-icon\" aria-hidden=\"true\"><span></span><span></span></span></button><div id=\"_R_4pb_\" class=\"site-nav-mobile\"><div class=\"site-nav-mobile-inner\"><div class=\"site-nav-mobile-links\"><a class=\"site-nav-mobile-link\" href=\"/buy\"><span>Buy</span><span>01</span></a><a class=\"site-nav-mobile-link\" href=\"/sell\"><span>Sell</span><span>02</span></a><a class=\"site-nav-mobile-link\" href=\"/home-valuation\"><span>Home Valuation</span><span>03</span></a><a class=\"site-nav-mobile-link\" href=\"/communities\"><span>Communities</span><span>04</span></a><a class=\"site-nav-mobile-link\" href=\"/reviews\"><span>Reviews</span><span>05</span></a><a class=\"site-nav-mobile-link\" href=\"/team\"><span>Team</span><span>06</span></a><a class=\"site-nav-mobile-link site-nav-mobile-link--active\" href=\"/about\"><span>About</span><span>07</span></a><a class=\"site-nav-mobile-link\" href=\"/contact\"><span>Contact</span><span>08</span></a></div><a class=\"site-nav-mobile-cta\" href=\"/home-valuation\">Get your home value <span aria-hidden=\"true\">↗</span></a></div></div></nav></div></header><main class=\"site-main\"><main class=\"editorial-page page-about\"><section class=\"editorial-hero about-hero\"><div class=\"editorial-hero-index\" aria-hidden=\"true\">04</div><div class=\"editorial-hero-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Our story</p></div><div class=\"\"><h1 class=\"editorial-hero-title\">Three generations.<em>One local commitment.</em></h1></div><div class=\"\"><p class=\"editorial-hero-description\">The Lathrop Team brings decades of Fox Cities experience to one of life’s most important decisions—with clear guidance, steady communication, and a personal approach.</p></div><div class=\"editorial-hero-actions\"><a class=\"btn btn--light\" href=\"/team\">Meet the team</a></div></div><div class=\"editorial-hero-mark\" aria-hidden=\"true\">L</div><div class=\"editorial-hero-footnote\"><span>Fox Cities, Wisconsin</span><span class=\"editorial-hero-footnote-line\"></span><span>Since the beginning</span></div></section><section class=\"about-story\"><div class=\"about-story-aside\"><span class=\"editorial-section-number\">01 — The Lathrop story</span><span class=\"about-story-mark\" aria-hidden=\"true\">3</span></div><div class=\"about-story-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>A family helping families</p><h2 class=\"editorial-section-title\">Real estate is more<em>than a transaction.</em></h2></div><div class=\"about-story-copy\"><p>Real estate has always been a family business for the Lathrop Team. Over more than 35 years, Diane Lathrop built a reputation for helping Fox Cities families make important moves with confidence.</p><p>Her experience and results place her among the top 0.17% of agents in Appleton, with 996 closed sales recorded on Zillow. Shane and Oliver joined the business with fresh energy and modern marketing, adding a new perspective to deeply rooted local knowledge.</p><p>Together, we bring experience, data, and empathy to each relationship—because buying or selling a home is not simply a financial decision. It is a life decision.</p></div></div></section><section class=\"about-values\"><div class=\"about-values-heading\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>How we show up</p><h2 class=\"editorial-section-title\">Grounded locally.<em>Focused on you.</em></h2></div></div><div class=\"about-values-list\"><div class=\"\"><article class=\"about-value\"><span class=\"about-value-number\">01</span><div class=\"about-value-content\"><h3>Experience that stays personal</h3><p>Diane Lathrop has built more than 35 years of Fox Cities market experience into a practice grounded in communication, consistency, and care for the people behind every move.</p></div></article></div><div class=\"\"><article class=\"about-value\"><span class=\"about-value-number\">02</span><div class=\"about-value-content\"><h3>A family perspective</h3><p>Shane and Oliver bring a new generation of energy and modern marketing to the local insight that has guided the team for decades. Together, we balance proven judgment with a current approach.</p></div></article></div><div class=\"\"><article class=\"about-value\"><span class=\"about-value-number\">03</span><div class=\"about-value-content\"><h3>Advice with empathy</h3><p>A real estate decision is rarely only about a property. We make room for the practical details, the financial questions, and the life change behind your next move.</p></div></article></div></div></section><section class=\"about-proof\"><div class=\"about-proof-heading\"><p class=\"editorial-eyebrow editorial-eyebrow--light\"><span class=\"editorial-eyebrow-rule\"></span>Results you can verify</p><h2>Documented performance.<em>Real client trust.</em></h2></div><div class=\"about-proof-content\"><div class=\"about-proof-stat-grid\"><article class=\"about-proof-stat\"><span class=\"about-proof-stat-value\">$27.24M</span><span class=\"about-proof-stat-label\">Closed volume in 2024</span></article><article class=\"about-proof-stat\"><span class=\"about-proof-stat-value\">76</span><span class=\"about-proof-stat-label\">Transaction sides in 2024</span></article><article class=\"about-proof-stat\"><span class=\"about-proof-stat-value\">525+</span><span class=\"about-proof-stat-label\">Five-star reviews</span></article></div><div class=\"about-proof-copy\"><p>The Lathrop Team’s 2024 production of $27.24M in closed volume across 76 transaction sides has been verified by RealTrends, an independent industry source that tracks production nationwide.</p><p>Over the years, clients have shared more than 525 five-star reviews on platforms including Zillow and Google. The figures are important, but the goal is always the same: that you feel informed, supported, and satisfied with the outcome.</p><a class=\"text-link\" href=\"/reviews\">Explore our review summary <span aria-hidden=\"true\">↗</span></a></div></div></section><section class=\"about-affiliation\"><div class=\"about-affiliation-mark\">KW</div><div class=\"about-affiliation-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Brokerage affiliation</p><h2 class=\"editorial-section-title\">Proudly affiliated with<em>Keller Williams Fox Cities.</em></h2><p class=\"about-affiliation-copy\">We operate as The Lathrop Team with our own identity and relationship-first approach, while being proudly affiliated with Keller Williams Fox Cities in Appleton. This gives our clients the personal attention of a boutique team backed by a major brokerage network.</p></div><div class=\"\"><address class=\"about-affiliation-address\"><strong>Keller Williams Fox Cities</strong><span>517 N. Westhill Blvd, Appleton, WI</span><span>Each office is independently owned and operated.</span></address></div></div></section><section class=\"editorial-closing-cta\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Let’s talk</p><h2>A local team for<em>your next chapter.</em></h2><p>Whether you are considering a move soon or simply beginning to explore your options, we are here to help you find a clear path.</p><a class=\"btn\" href=\"/contact\">Start a conversation</a></div></section></main><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-top\"><div class=\"footer-brand\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><p>A three-generation Fox Cities real estate team bringing local perspective, documented performance, and personal guidance to every move.</p><a class=\"footer-text-link\" href=\"/contact\">Start a conversation <span aria-hidden=\"true\">↗</span></a></div><div class=\"footer-navigation\"><p class=\"footer-heading\">Explore</p><div class=\"footer-nav-links\"><a href=\"/buy\">Buy</a><a href=\"/sell\">Sell</a><a href=\"/home-valuation\">Home Valuation</a><a href=\"/communities\">Communities</a><a href=\"/team\">Team</a><a href=\"/about\">About</a><a href=\"/reviews\">Reviews</a><a href=\"/contact\">Contact</a></div></div><div class=\"footer-contact\"><p class=\"footer-heading\">Direct contact</p><address><p><strong>Diane Lathrop</strong><a href=\"mailto:diane@lathropteam.com\">diane@lathropteam.com</a><a href=\"tel:+19204289227\">(920) 428-9227</a></p><p><strong>Shane Lathrop</strong><a href=\"mailto:shane@lathropteam.com\">shane@lathropteam.com</a><a href=\"tel:+19204280066\">(920) 428-0066</a></p><p><strong>Oliver Lathrop</strong><a href=\"mailto:oliver@lathropteam.com\">oliver@lathropteam.com</a><a href=\"tel:+19208584424\">(920) 858-4424</a></p></address></div><div class=\"footer-map\"><div class=\"footer-map-header\"><p class=\"footer-heading\">Office location</p><span>Appleton, Wisconsin</span></div><div class=\"footer-map-frame\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2857.210069477556!2d-88.46770222396349!3d44.26449767107976!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8803b7a5ba3b6f2d%3A0x6b0d2f80904d9e2f!2sKeller%20Williams%20Fox%20Cities!5e0!3m2!1sen!2sin!4v1788252496599!5m2!1sen!2sin\" title=\"Keller Williams Fox Cities office location in Appleton, Wisconsin\" width=\"600\" height=\"450\" style=\"border:0\" allowFullScreen=\"\" loading=\"lazy\" referrerPolicy=\"strict-origin-when-cross-origin\"></iframe></div></div></div><div class=\"site-footer-compliance\"><div class=\"footer-kw\"><div class=\"footer-kw-heading\"><p>Keller Williams Fox Cities</p><img alt=\"Keller Williams Fox Cities\" loading=\"lazy\" width=\"132\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"footer-kw-logo\" style=\"color:transparent\" src=\"/PLACEHOLDER-KW-LOGO.jpg\"/></div><address>517 N. Westhill Blvd, Appleton, WI<br/>Each office is independently owned and operated.</address></div><div class=\"footer-compliance-marks\"><div class=\"footer-compliance-mark\"><img alt=\"Equal Housing Opportunity\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/PLACEHOLDER-EQUAL-HOUSING.jpg\"/><span>Equal Housing Opportunity</span></div><div class=\"footer-compliance-mark\"><img alt=\"REALTOR®\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/PLACEHOLDER-REALTOR-MARK.jpg\"/><span>REALTOR®</span></div></div></div><div class=\"site-footer-bottom\"><p>© <!-- -->2026<!-- --> Lathrop Team. All rights reserved.</p><div><span>Fox Cities, Wisconsin</span><span>RealTrends Verified · 525+ five-star reviews</span></div></div></footer></div><script src=\"/_next/static/chunks/webpack-c382ed19c2311dcb.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[5948,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"356\\\",\\\"static/chunks/356-ba125e9f1b9f7c55.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-2bdc083cbf7c6af6.js\\\"],\\\"default\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[5413,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"220\\\",\\\"static/chunks/app/about/page-44b8c3991ffaadf0.js\\\"],\\\"default\\\"]\\n6:I[2619,[\\\"214\\\",\\\"static/chunks/214-628d75f432f1dabd.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"220\\\",\\\"static/chunks/app/about/page-44b8c3991ffaadf0.js\\\"],\\\"\\\"]\\ne:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/7d6937842080f396.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/0610f662fb4f8aec.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"D8O5FRMMvIjTCrxW8kMaC\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"about\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"about\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/7d6937842080f396.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$und