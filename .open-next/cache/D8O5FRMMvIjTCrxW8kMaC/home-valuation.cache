{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/home-valuation/layout,_N_T_/home-valuation/page,_N_T_/home-valuation"}},"html":"<!DOCTYPE html><!--D8O5FRMMvIjTCrxW8kMaC--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"logos/1.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7d6937842080f396.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/0610f662fb4f8aec.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-c382ed19c2311dcb.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f10ca8562d68747b.js\" async=\"\"></script><script src=\"/_next/static/chunks/214-628d75f432f1dabd.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/356-ba125e9f1b9f7c55.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2bdc083cbf7c6af6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/home-valuation/page-82ae5d8570b16a5f.js\" async=\"\"></script><title>Home Valuation | Lathrop Team | Lathrop Team</title><meta name=\"description\" content=\"Get a personalized valuation for your Fox Cities home from a three-generation team with 35+ years of local market experience.\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div class=\"boot-screen\" aria-hidden=\"true\"><div class=\"boot-screen-frame\"></div><div class=\"boot-screen-content\"><p class=\"boot-screen-message\">You&#x27;re at the perfect place for<span>Fox Cities real estate talk!</span></p></div><span class=\"boot-screen-index\">Fox Cities, Wisconsin</span></div><div class=\"page-transition-overlay\" aria-hidden=\"true\"><div class=\"page-transition-frame\"></div><span class=\"page-transition-mark\">L</span></div><div class=\"site site--loading\" aria-hidden=\"true\"><header class=\"site-header\"><div class=\"site-header-inner\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" width=\"44\" height=\"44\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><nav class=\"site-nav-wrap\" aria-label=\"Main navigation\"><div class=\"site-nav-desktop\"><a class=\"nav-link\" href=\"/buy\">Buy</a><a class=\"nav-link\" href=\"/sell\">Sell</a><a class=\"nav-link nav-link--active\" href=\"/home-valuation\">Home Valuation</a><a class=\"nav-link\" href=\"/communities\">Communities</a><a class=\"nav-link\" href=\"/reviews\">Reviews</a><a class=\"nav-link\" href=\"/team\">Team</a><a class=\"nav-link\" href=\"/about\">About</a><a class=\"nav-link\" href=\"/contact\">Contact</a></div><button class=\"site-nav-toggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"_R_4pb_\"><span class=\"site-nav-toggle-label\">Menu</span><span class=\"site-nav-toggle-icon\" aria-hidden=\"true\"><span></span><span></span></span></button><div id=\"_R_4pb_\" class=\"site-nav-mobile\"><div class=\"site-nav-mobile-inner\"><div class=\"site-nav-mobile-links\"><a class=\"site-nav-mobile-link\" href=\"/buy\"><span>Buy</span><span>01</span></a><a class=\"site-nav-mobile-link\" href=\"/sell\"><span>Sell</span><span>02</span></a><a class=\"site-nav-mobile-link site-nav-mobile-link--active\" href=\"/home-valuation\"><span>Home Valuation</span><span>03</span></a><a class=\"site-nav-mobile-link\" href=\"/communities\"><span>Communities</span><span>04</span></a><a class=\"site-nav-mobile-link\" href=\"/reviews\"><span>Reviews</span><span>05</span></a><a class=\"site-nav-mobile-link\" href=\"/team\"><span>Team</span><span>06</span></a><a class=\"site-nav-mobile-link\" href=\"/about\"><span>About</span><span>07</span></a><a class=\"site-nav-mobile-link\" href=\"/contact\"><span>Contact</span><span>08</span></a></div><a class=\"site-nav-mobile-cta\" href=\"/home-valuation\">Get your home value <span aria-hidden=\"true\">↗</span></a></div></div></nav></div></header><main class=\"site-main\"><main class=\"editorial-page page-valuation\"><section class=\"editorial-hero valuation-hero\"><div class=\"editorial-hero-index\" aria-hidden=\"true\">03</div><div class=\"editorial-hero-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>Home valuation</p></div><div class=\"\"><h1 class=\"editorial-hero-title\">See your home<em>with local perspective.</em></h1></div><div class=\"\"><p class=\"editorial-hero-description\">Online estimates are a starting point. A thoughtful valuation considers your home, your neighborhood, and the real choices in front of you.</p></div><div class=\"editorial-hero-actions\"><a href=\"#valuation-form\" class=\"btn btn--light\">Get your home value</a></div></div><div class=\"editorial-hero-mark\" aria-hidden=\"true\">V</div><div class=\"editorial-hero-footnote\"><span>Fox Cities, Wisconsin</span><span class=\"editorial-hero-footnote-line\"></span><span>Personalized valuation</span></div></section><section class=\"valuation-intro\"><div class=\"valuation-intro-aside\"><span class=\"editorial-section-number\">01 — Beyond an estimate</span><span class=\"valuation-intro-mark\" aria-hidden=\"true\">L</span></div><div class=\"valuation-intro-content\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>A more complete picture</p><h2 class=\"editorial-section-title\">A number should come<em>with an explanation.</em></h2></div><div class=\"valuation-intro-copy\"><p>A home value is more than an online estimate. It is a market position shaped by timing, location, condition, presentation, and the homes buyers are comparing yours against.</p><p>With more than 35 years of Fox Cities experience, the Lathrop Team gives you a clear, local perspective before you decide what comes next.</p></div></div></section><section class=\"valuation-considerations\"><div class=\"valuation-considerations-heading\"><div class=\"\"><p class=\"editorial-eyebrow\"><span class=\"editorial-eyebrow-rule\"></span>What we consider</p><h2 class=\"editorial-section-title\">Built around your<em>specific property.</em></h2></div></div><div class=\"valuation-considerations-list\"><div class=\"\"><article class=\"valuation-consideration\"><span class=\"valuation-consideration-number\">01</span><div class=\"valuation-consideration-content\"><h3>The immediate market</h3><p>We look at the homes currently competing for buyers, the recent sales setting expectations, and the direction the local market is moving.</p></div></article></div><div class=\"\"><article class=\"valuation-consideration\"><span class=\"valuation-consideration-number\">02</span><div class=\"valuation-consideration-content\"><h3>Your home in context</h3><p>Updates, condition, lot, layout, location, and the details buyers notice all matter. Square footage alone cannot tell the full story.</p></div></article></div><div class=\"\"><article class=\"valuation-consideration\"><span class=\"valuation-consideration-number\">03</span><div class=\"valuation-consideration-content\"><h3>A practical next step</h3><p>You receive a realistic perspective to help you plan—whether you are preparing to sell soon, considering a future move, or simply looking for clarity.</p></div></article></div></div></section><section class=\"valuation-form-section\" id=\"valuation-form\"><div class=\"valuation-form-intro\"><div class=\"\"><p class=\"editorial-eyebrow editorial-eyebrow--light\"><span class=\"editorial-eyebrow-rule\"></span>Request your valuation</p><h2>Tell us a little<em>about your home.</em></h2><p>Share the basics below. We will review your property details and follow up with a personalized valuation—not an automated number.</p></div><div class=\"\"><div class=\"valuation-form-assurance\"><span>What happens next</span><p>A member of the Lathrop Team will review your details and follow up personally to discuss your home and timing.</p></div></div></div><div class=\"valuation-form-panel\"><form class=\"form form--valuation\"><fieldset class=\"form-fieldset\"><legend class=\"form-legend\">Your property</legend><div class=\"form-row\"><label class=\"form-label\">Property address<input class=\"form-input\" type=\"text\" required=\"\" autoComplete=\"street-address\" placeholder=\"Street address\" name=\"address\"/></label></div><div class=\"form-row form-row--location\"><label class=\"form-label\">City<input class=\"form-input\" type=\"text\" required=\"\" autoComplete=\"address-level2\" placeholder=\"Appleton\" name=\"city\"/></label><label class=\"form-label form-label--state\">State<input class=\"form-input\" type=\"text\" required=\"\" autoComplete=\"address-level1\" maxLength=\"2\" placeholder=\"WI\" name=\"state\"/></label><label class=\"form-label form-label--zip\">ZIP<input class=\"form-input\" type=\"text\" required=\"\" autoComplete=\"postal-code\" inputMode=\"numeric\" placeholder=\"54914\" name=\"zip\"/></label></div><div class=\"form-row form-row--property-details\"><label class=\"form-label\">Beds<input class=\"form-input\" type=\"number\" min=\"0\" inputMode=\"numeric\" placeholder=\"3\" name=\"beds\"/></label><label class=\"form-label\">Baths<input class=\"form-input\" type=\"number\" min=\"0\" step=\"0.5\" inputMode=\"decimal\" placeholder=\"2\" name=\"baths\"/></label><label class=\"form-label\">Approx. square feet<input class=\"form-input\" type=\"number\" min=\"0\" inputMode=\"numeric\" placeholder=\"1800\" name=\"sqft\"/></label></div><div class=\"form-row\"><label class=\"form-label\">When are you thinking of selling?<select class=\"form-input\" name=\"timeframe\"><option value=\"\" disabled=\"\" selected=\"\">Choose an option</option><option value=\"0-3\">Within 0–3 months</option><option value=\"3-6\">Within 3–6 months</option><option value=\"6-12\">Within 6–12 months</option><option value=\"12+\">12+ months / just curious</option></select></label></div></fieldset><fieldset class=\"form-fieldset\"><legend class=\"form-legend\">Your contact details</legend><div class=\"form-row\"><label class=\"form-label\">Name<input class=\"form-input\" type=\"text\" required=\"\" autoComplete=\"name\" placeholder=\"Your name\" name=\"name\"/></label></div><div class=\"form-row form-row--contact-details\"><label class=\"form-label\">Email<input class=\"form-input\" type=\"email\" required=\"\" autoComplete=\"email\" placeholder=\"you@example.com\" name=\"email\"/></label><label class=\"form-label\">Phone<input class=\"form-input\" type=\"tel\" autoComplete=\"tel\" inputMode=\"tel\" placeholder=\"(920) 555-1234\" name=\"phone\"/></label></div></fieldset><div class=\"form-row form-actions form-actions--valuation\"><button class=\"btn btn--primary\">Get my valuation</button><p class=\"form-note\">Your details are used only to prepare and follow up on your valuation.</p></div><div class=\"form-status-wrap\" aria-live=\"polite\"></div></form></div></section></main><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"site-footer-top\"><div class=\"footer-brand\"><a class=\"site-logo\" aria-label=\"Lathrop Team Home\" href=\"/\"><img alt=\"Lathrop Team logo\" loading=\"lazy\" width=\"42\" height=\"42\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/logos/1.jpg\"/><span class=\"site-logo-text\">Lathrop Team</span></a><p>A three-generation Fox Cities real estate team bringing local perspective, documented performance, and personal guidance to every move.</p><a class=\"footer-text-link\" href=\"/contact\">Start a conversation <span aria-hidden=\"true\">↗</span></a></div><div class=\"footer-navigation\"><p class=\"footer-heading\">Explore</p><div class=\"footer-nav-links\"><a href=\"/buy\">Buy</a><a href=\"/sell\">Sell</a><a href=\"/home-valuation\">Home Valuation</a><a href=\"/communities\">Communities</a><a href=\"/team\">Team</a><a href=\"/about\">About</a><a href=\"/reviews\">Reviews</a><a href=\"/contact\">Contact</a></div></div><div class=\"footer-contact\"><p class=\"footer-heading\">Direct contact</p><address><p><strong>Diane Lathrop</strong><a href=\"mailto:diane@lathropteam.com\">diane@lathropteam.com</a><a href=\"tel:+19204289227\">(920) 428-9227</a></p><p><strong>Shane Lathrop</strong><a href=\"mailto:shane@lathropteam.com\">shane@lathropteam.com</a><a href=\"tel:+19204280066\">(920) 428-0066</a></p><p><strong>Oliver Lathrop</strong><a href=\"mailto:oliver@lathropteam.com\">oliver@lathropteam.com</a><a href=\"tel:+19208584424\">(920) 858-4424</a></p></address></div><div class=\"footer-map\"><div class=\"footer-map-header\"><p class=\"footer-heading\">Office location</p><span>Appleton, Wisconsin</span></div><div class=\"footer-map-frame\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2857.210069477556!2d-88.46770222396349!3d44.26449767107976!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8803b7a5ba3b6f2d%3A0x6b0d2f80904d9e2f!2sKeller%20Williams%20Fox%20Cities!5e0!3m2!1sen!2sin!4v1788252496599!5m2!1sen!2sin\" title=\"Keller Williams Fox Cities office location in Appleton, Wisconsin\" width=\"600\" height=\"450\" style=\"border:0\" allowFullScreen=\"\" loading=\"lazy\" referrerPolicy=\"strict-origin-when-cross-origin\"></iframe></div></div></div><div class=\"site-footer-compliance\"><div class=\"footer-kw\"><div class=\"footer-kw-heading\"><p>Keller Williams Fox Cities</p><img alt=\"Keller Williams Fox Cities\" loading=\"lazy\" width=\"132\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"footer-kw-logo\" style=\"colo